  "interpolation_models": {
    "aat_trak_table": {
      "method": {
        "$type": "string",
        "$value": "2D Linear / Piecewise Table Interpolation"
      },
      "description": {
        "$type": "string",
        "$value": "Apple Advanced Typography (AAT) 'trak' table standard: font layout engine interpolates between adjacent point-size stops using linear interpolation of per-size track values in FUnits."
      },
      "formula": {
        "$type": "string",
        "$value": "tracking(p) = y0 + (p - x0) / (x1 - x0) * (y1 - y0)"
      },
      "citation": "https://developer.apple.com/fonts/TrueType-Reference-Manual/RM06/Chap6trak.html"
    },
    "cubic_polynomial_model": {
      "description": {
        "$type": "string",
        "$value": "Analytical cubic polynomial regression for SF Pro Text tracking (6pt <= p <= 20pt) computed via least-squares fit against Apple HIG ground truth."
      },
      "formula": {
        "$type": "string",
        "$value": "Tracking_pt(p) = a * p^3 + b * p^2 + c * p + d"
      },
      "coefficients_pt": {
        "a": {
          "$type": "number",
          "$value": 0.00063705,
          "$description": "Cubic coefficient (pt^-2)"
        },
        "b": {
          "$type": "number",
          "$value": -0.02544432,
          "$description": "Quadratic coefficient (pt^-1)"
        },
        "c": {
          "$type": "number",
          "$value": 0.25807866,
          "$description": "Linear coefficient (dimensionless)"
        },
        "d": {
          "$type": "number",
          "$value": -0.54399659,
          "$description": "Constant offset (pt)"
        }
      },
      "coefficients_1000em": {
        "a": {
          "$type": "number",
          "$value": 0.02396514
        },
        "b": {
          "$type": "number",
          "$value": -0.62565539
        },
        "c": {
          "$type": "number",
          "$value": -1.61943666
        },
        "d": {
          "$type": "number",
          "$value": 67.50263234
        }
      },
      "accuracy_metrics": {
        "r_squared": {
          "$type": "number",
          "$value": 0.9942
        },
        "max_error_pt": {
          "$type": "dimension",
          "$value": "0.0497pt"
        },
        "mean_error_pt": {
          "$type": "dimension",
          "$value": "0.0134pt"
        }
      }
    },
    "spec_001_calibration": {
      "description": {
        "$type": "string",
        "$value": "SPEC-001 Section 2.1 B benchmark points and calibration notes."
      },
      "benchmark_points": {
        "p_11_pt": {
          "spec_value": "-0.23pt",
          "hig_ground_truth": "+0.06pt"
        },
        "p_13_pt": {
          "spec_value": "-0.08pt",
          "hig_ground_truth": "-0.08pt"
        },
        "p_17_pt": {
          "spec_value": "0.00pt",
          "hig_ground_truth": "-0.43pt"
        }
      },
      "analysis": {
        "$type": "string",
        "$value": "In SPEC-001 line 74-76, 13pt matches HIG (-0.08pt). The 11pt spec value of -0.23pt matches the HIG 15pt value, and 17pt value of 0.00pt matches the HIG 12pt zero-crossing. The canonical HIG ground truth provides positive tracking at 11pt (+0.06pt) for optical legibility."
      }
    }
  },
