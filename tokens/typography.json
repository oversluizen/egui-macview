{
  "$name": "egui-macview Typography & Tracking Tokens",
  "$version": "1.0.0",
  "$description": "W3C DTCG-compliant typography token catalog for egui-macview. Fully grounded in Apple Developer Documentation, macOS Human Interface Guidelines (HIG), Apple Advanced Typography (AAT) 'trak' table specifications, and AppKit NSFont / NSTextField metrics.",
  "$extensions": {
    "apple_documentation_urls": [
      "https://developer.apple.com/design/human-interface-guidelines/typography",
      "https://developer.apple.com/tutorials/data/design/human-interface-guidelines/typography.json",
      "https://developer.apple.com/fonts/TrueType-Reference-Manual/RM06/Chap6trak.html",
      "https://developer.apple.com/documentation/appkit/nsfont",
      "https://developer.apple.com/documentation/coretext/kcttrackingattributename"
    ]
  },
  "optical_sizing": {
    "threshold": {
      "$type": "dimension",
      "$value": "20.0pt",
      "$description": "Exact optical size breakpoint where Apple typography transitions from SF Pro Text to SF Pro Display.",
      "$extensions": {
        "rule": "font_size < 20.0pt -> SF Pro Text; font_size >= 20.0pt -> SF Pro Display",
        "variable_font_axis": "opsz (optical size axis: 17.0 - 1024.0)",
        "apple_citation": "Apple HIG Typography - Optical Sizes & WWDC Dynamic Type Specifications"
      }
    },
    "subfamilies": {
      "text": {
        "family_name": {
          "$type": "string",
          "$value": "SF Pro Text"
        },
        "min_size": {
          "$type": "dimension",
          "$value": "6.0pt"
        },
        "max_size": {
          "$type": "dimension",
          "$value": "19.999pt"
        },
        "design_characteristics": {
          "$type": "string",
          "$value": "Wider counters, taller x-height, slightly heavier stems, and more open natural sidebearings to maintain legibility at reading scales."
        }
      },
      "display": {
        "family_name": {
          "$type": "string",
          "$value": "SF Pro Display"
        },
        "min_size": {
          "$type": "dimension",
          "$value": "20.0pt"
        },
        "max_size": {
          "$type": "dimension",
          "$value": "1024.0pt"
        },
        "design_characteristics": {
          "$type": "string",
          "$value": "Tighter letterforms, compact sidebearings, refined stroke contrasts, and narrower proportions for display and title impact."
        }
      }
    }
  },
