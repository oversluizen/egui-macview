<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="23504" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="23504"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSWindowController"/>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <window title="AVKit Audio Mastering Strip" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" animationBehavior="default" id="win-root-audio">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
            <rect key="contentRect" x="196" y="240" width="720" height="664"/>
            <rect key="screenRect" x="0.0" y="0.0" width="1680" height="1027"/>
            <view key="contentView" identifier="root-audio" id="root-audio">
                <rect key="frame" x="0.0" y="0.0" width="720" height="664"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <textField identifier="s5-hdr" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="s5-hdr">
                        <rect key="frame" x="12" y="640" width="520" height="18"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" editable="NO" title="5. AVKit Media Studio, Trim Scrubber &amp; Audio Mastering" id="cell-s5-hdr">
                            <font key="font" metaFont="systemSemibold"/>
                        </textFieldCell>
                    </textField>
                    <textField identifier="s5-sub" horizontalHuggingPriority="251" verticalHuggingPriority="750" controlSize="small" id="s5-sub">
                        <rect key="frame" x="12" y="624" width="680" height="16"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" controlSize="small" lineBreakMode="clipping" editable="NO" title="4K Procedural Video Viewport, Frame-Accurate Trim Scrubber, Rotary Knobs, and Stereo Peak/RMS VU Meters" id="cell-s5-sub">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>
                    <customView identifier="s5-video-view" customClass="NSAvKitVideoAndScrubberView" id="s5-video-view">
                        <rect key="frame" x="12" y="344" width="696" height="276"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    </customView>
                    <button identifier="s5-btn-play" verticalHuggingPriority="750" id="s5-btn-play">
                        <rect key="frame" x="12" y="312" width="110" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Play / Pause" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="cell-s5-btn-play">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="togglePlay:" target="-2" id="a-s5-btn-play"/>
                        </connections>
                    </button>
                    <button identifier="s5-btn-prev" verticalHuggingPriority="750" id="s5-btn-prev">
                        <rect key="frame" x="130" y="312" width="84" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Step -1f" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="cell-s5-btn-prev">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="stepFramePrev:" target="-2" id="a-s5-btn-prev"/>
                        </connections>
                    </button>
                    <button identifier="s5-btn-next" verticalHuggingPriority="750" id="s5-btn-next">
                        <rect key="frame" x="222" y="312" width="84" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Step +1f" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="cell-s5-btn-next">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="stepFrameNext:" target="-2" id="a-s5-btn-next"/>
                        </connections>
                    </button>
                    <textField identifier="s5-lbl-nudge" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="s5-lbl-nudge">
                        <rect key="frame" x="318" y="316" width="68" height="18"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" editable="NO" title="Nudge (s):" id="cell-s5-lbl-nudge">
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <stepper identifier="s5-stp-play" horizontalHuggingPriority="750" verticalHuggingPriority="750" id="s5-stp-play">
                        <rect key="frame" x="390" y="314" width="24" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <stepperCell key="cell" continuous="YES" alignment="left" increment="0.5" minValue="-10000" maxValue="10000" id="cell-s5-stp-play"/>
                        <connections>
                            <binding destination="-2" name="value" keyPath="values.mediaPlayhead" id="b-s5-stp-play"/>
                        </connections>
                    </stepper>
                    <button identifier="s5-sw-loop" verticalHuggingPriority="750" id="s5-sw-loop">
                        <rect key="frame" x="428" y="314" width="116" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="check" title="Loop In/Out" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="cell-s5-sw-loop">
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <binding destination="-2" name="value" keyPath="values.loopPlayback" id="b-s5-sw-loop"/>
                        </connections>
                    </button>
                    <button identifier="s5-btn-wav" verticalHuggingPriority="750" id="s5-btn-wav">
                        <rect key="frame" x="556" y="312" width="152" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Export Trimmed WAV" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="cell-s5-btn-wav">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="exportTrimmedWav:" target="-2" id="a-s5-btn-wav"/>
                        </connections>
                    </button>
                    <box identifier="s5-box-rotary" title="AVKit Rotary Mastering Strip &amp; Stereo Peak/RMS VU Meters" id="s5-box-rotary">
                        <rect key="frame" x="12" y="182" width="696" height="122"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <view key="contentView" id="cv-s5-box-rotary">
                            <rect key="frame" x="4" y="5" width="688" height="102"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        </view>
                    </box>
                    <textField identifier="s5-lbl-kgain" horizontalHuggingPriority="251" verticalHuggingPriority="750" controlSize="small" id="s5-lbl-kgain">
                        <rect key="frame" x="28" y="262" width="44" height="14"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" controlSize="small" lineBreakMode="clipping" editable="NO" title="Gain" id="cell-s5-lbl-kgain">
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <slider identifier="s5-knb-gain" verticalHuggingPriority="750" id="s5-knb-gain">
                        <rect key="frame" x="24" y="216" width="42" height="42"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <sliderCell key="cell" state="on" alignment="left" minValue="0" maxValue="2" doubleValue="0" tickMarkPosition="above" numberOfTickMarks="9" sliderType="circular" id="cell-s5-knb-gain"/>
                        <connections>
                            <binding destination="-2" name="value" keyPath="values.mediaGain" id="b-s5-knb-gain"/>
                        </connections>
                    </slider>
                    <textField identifier="s5-lbl-kpan" horizontalHuggingPriority="251" verticalHuggingPriority="750" controlSize="small" id="s5-lbl-kpan">
