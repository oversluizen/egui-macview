                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" controlSize="small" lineBreakMode="clipping" editable="NO" title="Drive" id="cell-s5-lbl-kdrv">
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <slider identifier="s5-knb-drv" verticalHuggingPriority="750" id="s5-knb-drv">
                        <rect key="frame" x="280" y="216" width="42" height="42"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <sliderCell key="cell" state="on" alignment="left" minValue="0" maxValue="1" doubleValue="0" tickMarkPosition="above" numberOfTickMarks="9" sliderType="circular" id="cell-s5-knb-drv"/>
                        <connections>
                            <binding destination="-2" name="value" keyPath="values.satDrive" id="b-s5-knb-drv"/>
                        </connections>
                    </slider>
                    <customView identifier="s5-vu-meters" customClass="NSAvKitStereoVuMetersView" id="s5-vu-meters">
                        <rect key="frame" x="344" y="192" width="352" height="86"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    </customView>
                    <box identifier="s5-box-master" title="AVKit Audio Mastering Strip (3_AVKit_Audio_Mastering_Strip.xib)" id="s5-box-master">
                        <rect key="frame" x="12" y="12" width="696" height="162"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <view key="contentView" id="cv-s5-box-master">
                            <rect key="frame" x="4" y="5" width="688" height="142"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        </view>
                    </box>
                    <textField identifier="s5-lbl-mgain" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="s5-lbl-mgain">
                        <rect key="frame" x="28" y="128" width="88" height="18"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" editable="NO" title="Master Gain:" id="cell-s5-lbl-mgain">
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <slider identifier="s5-sld-mgain" verticalHuggingPriority="750" id="s5-sld-mgain">
                        <rect key="frame" x="120" y="126" width="210" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <sliderCell key="cell" state="on" alignment="left" minValue="0" maxValue="2" doubleValue="0" tickMarkPosition="above" numberOfTickMarks="0" sliderType="linear" id="cell-s5-sld-mgain"/>
                        <connections>
                            <binding destination="-2" name="value" keyPath="values.mediaGain" id="b-s5-sld-mgain"/>
                        </connections>
                    </slider>
                    <textField identifier="s5-num-mgain" verticalHuggingPriority="750" customClass="GSSteppingTextField" id="s5-num-mgain">
                        <rect key="frame" x="340" y="126" width="76" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" state="on" borderStyle="bezel" title="" drawsBackground="YES" id="cell-s5-num-mgain">
                            <numberFormatter key="formatter" formatterBehavior="default10_4" numberStyle="decimal" minimumIntegerDigits="1" maximumIntegerDigits="2000000000" maximumFractionDigits="3" id="fmt-s5-num-mgain">
                                <real key="minimum" value="0"/>
                                <real key="maximum" value="2"/>
                            </numberFormatter>
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                        <connections>
                            <binding destination="-2" name="value" keyPath="values.mediaGain" id="b-s5-num-mgain"/>
                        </connections>
                    </textField>
