                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" controlSize="small" lineBreakMode="clipping" editable="NO" title="Pan" id="cell-s5-lbl-kpan">
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <slider identifier="s5-knb-pan" verticalHuggingPriority="750" id="s5-knb-pan">
                        <rect key="frame" x="88" y="216" width="42" height="42"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <sliderCell key="cell" state="on" alignment="left" minValue="-1" maxValue="1" doubleValue="-1" tickMarkPosition="above" numberOfTickMarks="9" sliderType="circular" id="cell-s5-knb-pan"/>
                        <connections>
                            <binding destination="-2" name="value" keyPath="values.mediaPan" id="b-s5-knb-pan"/>
                        </connections>
                    </slider>
                    <textField identifier="s5-lbl-kzoom" horizontalHuggingPriority="251" verticalHuggingPriority="750" controlSize="small" id="s5-lbl-kzoom">
                        <rect key="frame" x="156" y="262" width="44" height="14"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" controlSize="small" lineBreakMode="clipping" editable="NO" title="Zoom" id="cell-s5-lbl-kzoom">
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <slider identifier="s5-knb-zoom" verticalHuggingPriority="750" id="s5-knb-zoom">
                        <rect key="frame" x="152" y="216" width="42" height="42"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <sliderCell key="cell" state="on" alignment="left" minValue="0.5" maxValue="2.5" doubleValue="0.5" tickMarkPosition="above" numberOfTickMarks="9" sliderType="circular" id="cell-s5-knb-zoom"/>
                        <connections>
                            <binding destination="-2" name="value" keyPath="values.mediaZoom" id="b-s5-knb-zoom"/>
                        </connections>
                    </slider>
                    <textField identifier="s5-lbl-krate" horizontalHuggingPriority="251" verticalHuggingPriority="750" controlSize="small" id="s5-lbl-krate">
                        <rect key="frame" x="220" y="262" width="44" height="14"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" controlSize="small" lineBreakMode="clipping" editable="NO" title="Speed" id="cell-s5-lbl-krate">
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <slider identifier="s5-knb-rate" verticalHuggingPriority="750" id="s5-knb-rate">
                        <rect key="frame" x="216" y="216" width="42" height="42"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <sliderCell key="cell" state="on" alignment="left" minValue="0.25" maxValue="2" doubleValue="0.25" tickMarkPosition="above" numberOfTickMarks="9" sliderType="circular" id="cell-s5-knb-rate"/>
                        <connections>
                            <binding destination="-2" name="value" keyPath="values.mediaSpeed" id="b-s5-knb-rate"/>
                        </connections>
                    </slider>
                    <textField identifier="s5-lbl-kdrv" horizontalHuggingPriority="251" verticalHuggingPriority="750" controlSize="small" id="s5-lbl-kdrv">
