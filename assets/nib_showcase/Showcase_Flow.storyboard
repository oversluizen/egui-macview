<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" initialViewController="wc-main">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="23504"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Main Studio Window Controller-->
        <scene sceneID="scene-window">
            <objects>
                <windowController id="wc-main" sceneMemberID="viewController">
                    <window key="window" title="MacView Studio Showcase Flow" allowsToolTipsWhenApplicationIsInactive="NO" autorecalculatesKeyViewLoop="NO" releasedWhenClosed="NO" visibleAtLaunch="NO" animationBehavior="default" id="win-main">
                        <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
                        <rect key="contentRect" x="196" y="240" width="720" height="520"/>
                        <rect key="screenRect" x="0.0" y="0.0" width="1680" height="1027"/>
                        <view key="contentView" identifier="win-cv" id="win-cv">
                            <rect key="frame" x="0.0" y="0.0" width="720" height="520"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        </view>
                    </window>
                    <connections>
                        <segue destination="vc-vector" kind="relationship" relationship="window.shadowedContentViewController" id="seg-root-content"/>
                    </connections>
                </windowController>
                <customObject id="fr-win" userLabel="First Responder" customClass="NSResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="80" y="120"/>
        </scene>
        <!--1. Vector & Transform Inspector-->
        <scene sceneID="scene-vector">
            <objects>
                <viewController title="1. Vector &amp; Transform Inspector" id="vc-vector" sceneMemberID="viewController">
                    <view key="view" identifier="root-sb-vec" id="view-vector">
                        <rect key="frame" x="0.0" y="0.0" width="520" height="360"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textField identifier="sb-vec-hdr" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="sb-vec-hdr">
                                <rect key="frame" x="20" y="316" width="360" height="22"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <textFieldCell key="cell" lineBreakMode="clipping" editable="NO" title="1. Vector &amp; Transform Inspector" id="cell-sb-vec-hdr">
                                    <font key="font" metaFont="systemSemibold" size="13"/>
                                </textFieldCell>
                            </textField>
                            <slider identifier="sb-vec-scale" verticalHuggingPriority="750" id="sb-vec-scale">
                                <rect key="frame" x="20" y="270" width="220" height="22"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <sliderCell key="cell" state="on" alignment="left" minValue="25" maxValue="250" doubleValue="100" tickMarkPosition="above" sliderType="linear" id="cell-sb-vec-scale"/>
                                <connections>
                                    <binding destination="vc-vector" name="value" keyPath="values.scalePercent" id="b-sb-vec-scale"/>
                                </connections>
                            </slider>
                            <button identifier="sb-vec-next" verticalHuggingPriority="750" id="sb-vec-next">
                                <rect key="frame" x="20" y="20" width="150" height="28"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="Typography Studio" bezelStyle="rounded" alignment="center" borderStyle="border" inset="2" id="cell-sb-vec-next"/>
                                <connections>
                                    <segue destination="vc-typography" kind="show" identifier="showTypography" id="seg-vec-to-typo"/>
                                </connections>
                            </button>
                            <button identifier="sb-vec-sheet" verticalHuggingPriority="750" id="sb-vec-sheet">
                                <rect key="frame" x="180" y="20" width="150" height="28"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="Appearance Sheet" bezelStyle="rounded" alignment="center" borderStyle="border" inset="2" id="cell-sb-vec-sheet"/>
                                <connections>
                                    <segue destination="vc-theme" kind="sheet" identifier="presentThemeSheet" id="seg-vec-to-theme"/>
                                </connections>
                            </button>
                            <button identifier="sb-vec-pop" verticalHuggingPriority="750" id="sb-vec-pop">
                                <rect key="frame" x="340" y="20" width="150" height="28"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="Inspector Popover" bezelStyle="rounded" alignment="center" borderStyle="border" inset="2" id="cell-sb-vec-pop"/>
                                <connections>
                                    <segue destination="vc-inspector" kind="popover" identifier="toggleInspectorPopover" popoverAnchorView="sb-vec-pop" popoverBehavior="t" preferredEdge="maxX" id="seg-vec-to-insp"/>
                                </connections>
                            </button>
                        </subviews>
                    </view>
                </viewController>
                <customObject id="fr-vec" userLabel="First Responder" customClass="NSResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="80" y="560"/>
        </scene>
        <!--2. Typography & Grid Studio-->
        <scene sceneID="scene-typography">
            <objects>
                <viewController title="2. Typography &amp; Grid Studio" id="vc-typography" sceneMemberID="viewController">
                    <view key="view" identifier="root-sb-typo" id="view-typography">
                        <rect key="frame" x="0.0" y="0.0" width="520" height="360"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textField identifier="sb-typo-hdr" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="sb-typo-hdr">
                                <rect key="frame" x="20" y="316" width="360" height="22"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <textFieldCell key="cell" lineBreakMode="clipping" editable="NO" title="2. Typography &amp; Grid Studio" id="cell-sb-typo-hdr"/>
                            </textField>
                            <button identifier="sb-typo-audio" verticalHuggingPriority="750" id="sb-typo-audio">
                                <rect key="frame" x="20" y="20" width="170" height="28"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="AVKit Mastering" bezelStyle="rounded" alignment="center" borderStyle="border" inset="2" id="cell-sb-typo-audio"/>
                                <connections>
                                    <segue destination="vc-audio" kind="show" identifier="showAudioMastering" id="seg-typo-to-audio"/>
                                </connections>
                            </button>
                        </subviews>
                    </view>
                </viewController>
                <customObject id="fr-typo" userLabel="First Responder" customClass="NSResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="680" y="560"/>
        </scene>
        <!--3. Appearance & WCAG Contrast-->
        <scene sceneID="scene-theme">
            <objects>
                <viewController title="3. Appearance &amp; WCAG Contrast" id="vc-theme" sceneMemberID="viewController">
                    <view key="view" identifier="root-sb-theme" id="view-theme">
                        <rect key="frame" x="0.0" y="0.0" width="520" height="360"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textField identifier="sb-theme-hdr" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="sb-theme-hdr">
                                <rect key="frame" x="20" y="316" width="360" height="22"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <textFieldCell key="cell" lineBreakMode="clipping" editable="NO" title="3. Appearance &amp; WCAG Contrast" id="cell-sb-theme-hdr"/>
                            </textField>
                            <button identifier="sb-theme-pub" verticalHuggingPriority="750" id="sb-theme-pub">
                                <rect key="frame" x="20" y="20" width="170" height="28"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <buttonCell key="cell" type="push" title="Publish Modal" bezelStyle="rounded" alignment="center" borderStyle="border" inset="2" id="cell-sb-theme-pub"/>
                                <connections>
                                    <segue destination="vc-publish" kind="modal" identifier="openPublishModal" id="seg-theme-to-pub"/>
                                </connections>
                            </button>
                        </subviews>
                    </view>
                </viewController>
                <customObject id="fr-theme" userLabel="First Responder" customClass="NSResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="680" y="120"/>
        </scene>
        <!--4. Publishing & Asset Queue-->
        <scene sceneID="scene-publish">
            <objects>
                <viewController title="4. Publishing &amp; Asset Queue" id="vc-publish" sceneMemberID="viewController">
                    <view key="view" identifier="root-sb-pub" id="view-publish">
                        <rect key="frame" x="0.0" y="0.0" width="520" height="360"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textField identifier="sb-pub-hdr" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="sb-pub-hdr">
                                <rect key="frame" x="20" y="316" width="360" height="22"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <textFieldCell key="cell" lineBreakMode="clipping" editable="NO" title="4. Publishing &amp; Asset Queue" id="cell-sb-pub-hdr"/>
                            </textField>
                        </subviews>
                    </view>
                </viewController>
                <customObject id="fr-pub" userLabel="First Responder" customClass="NSResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1280" y="120"/>
        </scene>
        <!--5. AVKit Audio Mastering Strip-->
        <scene sceneID="scene-audio">
            <objects>
                <viewController title="5. AVKit Audio Mastering Strip" id="vc-audio" sceneMemberID="viewController">
                    <view key="view" identifier="root-sb-audio" id="view-audio">
                        <rect key="frame" x="0.0" y="0.0" width="520" height="360"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textField identifier="sb-audio-hdr" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="sb-audio-hdr">
                                <rect key="frame" x="20" y="316" width="360" height="22"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <textFieldCell key="cell" lineBreakMode="clipping" editable="NO" title="5. AVKit Audio Mastering Strip" id="cell-sb-audio-hdr"/>
                            </textField>
                        </subviews>
                    </view>
                </viewController>
                <customObject id="fr-audio" userLabel="First Responder" customClass="NSResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1280" y="560"/>
        </scene>
        <!--Right Inspector Popover-->
        <scene sceneID="scene-inspector">
            <objects>
                <viewController title="Right Inspector" id="vc-inspector" sceneMemberID="viewController">
                    <view key="view" identifier="root-sb-insp" id="view-inspector">
                        <rect key="frame" x="0.0" y="0.0" width="340" height="480"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textField identifier="sb-insp-hdr" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="sb-insp-hdr">
                                <rect key="frame" x="16" y="440" width="280" height="20"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                <textFieldCell key="cell" lineBreakMode="clipping" editable="NO" title="Right Inspector (.storyboard Popover)" id="cell-sb-insp-hdr"/>
                            </textField>
                        </subviews>
                    </view>
                </viewController>
                <customObject id="fr-insp" userLabel="First Responder" customClass="NSResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="80" y="1020"/>
        </scene>
    </scenes>
</document>
