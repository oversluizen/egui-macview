                            <font key="font" metaFont="system"/>
                            <segments>
                                <segment label="Mac Traffic" selected="YES"/>
                                <segment label="Win 11 Caption"/>
                            </segments>
                        </segmentedCell>
                        <connections>
                            <binding destination="-2" name="selectedIndex" keyPath="values.windowStyle" id="b-s3-seg-win"/>
                        </connections>
                    </segmentedControl>
                    <textField identifier="s3-lbl-cnt" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="s3-lbl-cnt">
                        <rect key="frame" x="28" y="84" width="88" height="18"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" editable="NO" title="Contrast Min:" id="cell-s3-lbl-cnt">
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <slider identifier="s3-sld-cnt" verticalHuggingPriority="750" id="s3-sld-cnt">
                        <rect key="frame" x="120" y="82" width="210" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <sliderCell key="cell" state="on" alignment="left" minValue="3" maxValue="15" doubleValue="3" tickMarkPosition="above" numberOfTickMarks="0" sliderType="linear" id="cell-s3-sld-cnt"/>
                        <connections>
                            <binding destination="-2" name="value" keyPath="values.contrastTarget" id="b-s3-sld-cnt"/>
                        </connections>
                    </slider>
                    <button identifier="s3-chk-hc" verticalHuggingPriority="750" id="s3-chk-hc">
                        <rect key="frame" x="348" y="82" width="240" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="check" title="Enforce WCAG AAA High Contrast" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="cell-s3-chk-hc">
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <binding destination="-2" name="value" keyPath="values.highContrast" id="b-s3-chk-hc"/>
                        </connections>
                    </button>
                    <button identifier="s3-sw-red" verticalHuggingPriority="750" id="s3-sw-red">
                        <rect key="frame" x="28" y="44" width="180" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="check" title="Reduce Transparency" bezelStyle="regularSquare" imagePosition="left" state="on" inset="2" id="cell-s3-sw-red">
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <binding destination="-2" name="value" keyPath="values.reduceTransparency" id="b-s3-sw-red"/>
                        </connections>
                    </button>
                    <button identifier="s3-help" verticalHuggingPriority="750" toolTip="AppKit Theme &amp; WCAG 2.1 Auditor Help: Switch between Aqua, Vibrant Light, DarkAqua, and Vibrant Dark appearances and verify AA/AAA contrast ratios." id="s3-help">
                        <rect key="frame" x="448" y="44" width="22" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="help" title="?" bezelStyle="helpButton" inset="2" id="cell-s3-help">
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="showThemeHelp:" target="-2" id="a-s3-help"/>
                        </connections>
                    </button>
                    <button identifier="s3-btn-audit" verticalHuggingPriority="750" id="s3-btn-audit">
                        <rect key="frame" x="480" y="42" width="206" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Audit Contrast Ratio" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="cell-s3-btn-audit">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="auditContrast:" target="-2" id="a-s3-btn-audit"/>
                        </connections>
                    </button>
                </subviews>
            </view>
        </window>
    </objects>
</document>
