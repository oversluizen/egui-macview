                        <textFieldCell key="cell" lineBreakMode="clipping" editable="NO" title="Bus Mode:" id="cell-s5-lbl-bus">
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <segmentedControl identifier="s5-seg-bus" verticalHuggingPriority="750" id="s5-seg-bus">
                        <rect key="frame" x="428" y="44" width="258" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <segmentedCell key="cell" borderStyle="border" alignment="left" style="rounded" trackingMode="selectOne" id="cell-s5-seg-bus">
                            <font key="font" metaFont="system"/>
                            <segments>
                                <segment label="Stereo" selected="YES"/>
                                <segment label="Mono"/>
                                <segment label="Mid-Side"/>
                            </segments>
                        </segmentedCell>
                        <connections>
                            <binding destination="-2" name="selectedIndex" keyPath="values.busMode" id="b-s5-seg-bus"/>
                        </connections>
                    </segmentedControl>
                    <textField identifier="s5-lbl-codec" horizontalHuggingPriority="251" verticalHuggingPriority="750" id="s5-lbl-codec">
                        <rect key="frame" x="28" y="16" width="88" height="18"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <textFieldCell key="cell" lineBreakMode="clipping" editable="NO" title="Media Stream:" id="cell-s5-lbl-codec">
                            <font key="font" metaFont="system"/>
                        </textFieldCell>
                    </textField>
                    <popUpButton identifier="s5-pop-codec" verticalHuggingPriority="750" id="s5-pop-codec">
                        <rect key="frame" x="120" y="14" width="236" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <popUpButtonCell key="cell" type="push" title="Big Buck Bunny (1080p MP4)" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" id="cell-s5-pop-codec">
                            <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="menu"/>
                            <menu key="menu" id="menu-s5-pop-codec">
                                <items>
                                    <menuItem title="Big Buck Bunny (1080p MP4)" state="on" id="mi-s5-pop-codec-0"/>
                                    <menuItem title="Sintel (4K Proxy MP4)" id="mi-s5-pop-codec-1"/>
                                    <menuItem title="Tears of Steel (VFX MP4)" id="mi-s5-pop-codec-2"/>
                                    <menuItem title="For Bigger Blazes (60fps MP4)" id="mi-s5-pop-codec-3"/>
                                    <menuItem title="J.S. Bach — Brandenburg (.ogg Audio)" id="mi-s5-pop-codec-4"/>
                                    <menuItem title="Claude Debussy — Clair de Lune (.ogg Audio)" id="mi-s5-pop-codec-5"/>
                                </items>
                            </menu>
                        </popUpButtonCell>
                        <connections>
                            <binding destination="-2" name="selectedIndex" keyPath="values.codecPreset" id="b-s5-pop-codec"/>
                        </connections>
                    </popUpButton>
                    <button identifier="s5-help" verticalHuggingPriority="750" toolTip="AVKit Media &amp; Mastering Help: Use the QuickTime Floating HUD or rotary knobs to control Gain, Pan, Zoom, Speed, In/Out trim points, and Stereo VU ballistics." id="s5-help">
                        <rect key="frame" x="364" y="14" width="22" height="22"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="help" title="?" bezelStyle="helpButton" inset="2" id="cell-s5-help">
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="showAudioHelp:" target="-2" id="a-s5-help"/>
                        </connections>
                    </button>
                    <button identifier="s5-btn-rst" verticalHuggingPriority="750" id="s5-btn-rst">
                        <rect key="frame" x="394" y="12" width="132" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Reset Channel" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="cell-s5-btn-rst">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="resetAudioStrip:" target="-2" id="a-s5-btn-rst"/>
                        </connections>
                    </button>
                    <button identifier="s5-btn-bnc" verticalHuggingPriority="750" id="s5-btn-bnc">
                        <rect key="frame" x="534" y="12" width="152" height="24"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Bounce Master" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="cell-s5-btn-bnc">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="bounceMaster:" target="-2" id="a-s5-btn-bnc"/>
                        </connections>
                    </button>
                </subviews>
            </view>
        </window>
    </objects>
</document>
